# Copy this file to profiles.yml on the integration machine only.
# Do not commit profiles.yml or any credential.
amazon_delivery_bi:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "{{ env_var('DBT_SQLSERVER_DRIVER', 'ODBC Driver 18 for SQL Server') }}"
      server: "{{ env_var('DBT_SQLSERVER_SERVER') }}"
      port: "{{ env_var('DBT_SQLSERVER_PORT', '1433') | int }}"
      database: "{{ env_var('DBT_SQLSERVER_DATABASE', 'AmazonDeliveryBI') }}"
      schema: dw
      authentication: sql
      user: "{{ env_var('DBT_SQLSERVER_USER') }}"
      password: "{{ env_var('DBT_SQLSERVER_PASSWORD') }}"
      encrypt: true
      trust_cert: false
      threads: 4
