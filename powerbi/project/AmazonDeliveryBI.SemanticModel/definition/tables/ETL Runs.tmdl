table 'ETL Runs'
	lineageTag: 2f501c30-4e54-4fd0-9384-d69c14ce518a

	measure 'Total ETL Runs' = COALESCE(COUNTROWS('ETL Runs'), 0)
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: b9a4b253-4a0e-4eed-bd72-26612a09c1ff

	measure 'Successful Runs' = COALESCE(CALCULATE([Total ETL Runs], KEEPFILTERS('ETL Runs'[overall_status] = "SUCCEEDED")), 0)
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: 928aeac5-29fd-46ff-8e8f-ecfeb3a27c35

	measure 'Failed Runs' = COALESCE(CALCULATE([Total ETL Runs], KEEPFILTERS('ETL Runs'[overall_status] = "FAILED")), 0)
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: 4f5b9f25-108f-4b6f-8a87-8d95aa633c4e

	measure 'Success Rate' = DIVIDE([Successful Runs], [Successful Runs] + [Failed Runs])
		formatString: 0.0%
		displayFolder: ETL Monitoring
		lineageTag: 886deb3c-f450-47e0-a486-fe6961cecbd3

	measure 'Average Execution Duration' = CALCULATE(AVERAGE('ETL Runs'[processing_duration_seconds]), KEEPFILTERS('ETL Runs'[overall_status] IN {"SUCCEEDED", "FAILED"}))
		formatString: 0.0 "s"
		displayFolder: ETL Monitoring
		lineageTag: 275dd94c-0c3f-49ff-b81b-843f43a7b838

	measure 'Latest Execution Timestamp' = MAX('ETL Runs'[start_time])
		formatString: dd/MM/yyyy HH:mm:ss
		displayFolder: ETL Monitoring
		lineageTag: 1ef4fa50-3b31-4b2b-b5b4-2298756e0794

	measure 'Latest Execution Status' = VAR LatestRun = TOPN(1, 'ETL Runs', 'ETL Runs'[start_time], DESC, 'ETL Runs'[execution_key], DESC) RETURN IF(ISEMPTY(LatestRun), "NO EXECUTIONS", CONCATENATEX(LatestRun, 'ETL Runs'[overall_status], ""))
		displayFolder: ETL Monitoring
		lineageTag: 8a556f81-721b-495e-94bb-f06a389a0b8c

	measure 'Latest Execution Label' = FORMAT([Latest Execution Timestamp], "dd/MM/yyyy HH:mm:ss")
		displayFolder: ETL Monitoring
		lineageTag: bcb1144c-944e-413f-a3ac-39eea1434c1b

	measure 'Execution Duration Seconds' = SELECTEDVALUE('ETL Runs'[processing_duration_seconds])
		formatString: 0.0 "s"
		displayFolder: ETL Monitoring
		lineageTag: 8694c5b9-0a22-4fe2-9357-977b78c41d18

	measure 'Latest Mage Status' = VAR LatestRun = TOPN(1, 'ETL Runs', 'ETL Runs'[start_time], DESC, 'ETL Runs'[execution_key], DESC) RETURN CONCATENATEX(LatestRun, 'ETL Runs'[mage_status], "")
		displayFolder: ETL Monitoring
		lineageTag: 56a1e34d-575b-4924-8e21-eb4c139edf19

	measure 'Latest dbt Status' = VAR LatestRun = TOPN(1, 'ETL Runs', 'ETL Runs'[start_time], DESC, 'ETL Runs'[execution_key], DESC) RETURN CONCATENATEX(LatestRun, 'ETL Runs'[dbt_status], "")
		displayFolder: ETL Monitoring
		lineageTag: 685f7e08-9f2d-489f-a151-75482314b849

	measure 'Total Inserted Rows' = CALCULATE(SUM('ETL Record Metrics'[records_inserted]), KEEPFILTERS('ETL Record Metrics'[is_chart_eligible] = TRUE()))
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: 569f398a-57a8-439e-ad24-9ba8c08cc94e

	measure 'Total Updated Rows' = CALCULATE(SUM('ETL Record Metrics'[records_updated]), KEEPFILTERS('ETL Record Metrics'[is_chart_eligible] = TRUE()))
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: 5a8aa3a4-fbd5-42f8-b740-28ae3a9144c0

	measure 'Total Rejected Rows' = CALCULATE(SUM('ETL Record Metrics'[records_rejected]), KEEPFILTERS('ETL Record Metrics'[is_chart_eligible] = TRUE()))
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: 98b4f4cf-47bc-4a56-82d3-93219428ccd0

	measure 'Total Unchanged Rows' = CALCULATE(SUM('ETL Record Metrics'[records_unchanged]), KEEPFILTERS('ETL Record Metrics'[is_chart_eligible] = TRUE()))
		formatString: #,0
		displayFolder: ETL Monitoring
		lineageTag: d1978a61-7283-4cab-b2ec-8fdf7d760f9f

	measure 'Unfinished Runs' =
			
			CALCULATE(
			    [Total ETL Runs],
			    KEEPFILTERS(
			        'ETL Runs'[overall_status]
			            IN {"STARTED", "WAITING_DBT", "IN_DOUBT"}
			    )
			)
		formatString: 0
		lineageTag: 5fcae5bb-970e-461d-820d-b21a5a9a978b

