	partition 'ETL Error Details' = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost\SQLEXPRESS", "AmazonDeliveryBI", [CreateNavigationProperties=false]),
				    Identity = Value.NativeQuery(Source, "SELECT DB_NAME() AS db_name, CONVERT(nvarchar(128), SERVERPROPERTY('ServerName')) AS server_name"),
				    Guarded = if Identity{0}[db_name] = "AmazonDeliveryBI" and Text.Upper(Identity{0}[server_name]) = "DESKTOP-OBDFK6B\SQLEXPRESS" then Source else error "ETL Monitoring requires the approved SQL Server PRIMARY target",
				    View = Guarded{[Schema="monitoring", Item="vw_etl_error_details"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table
